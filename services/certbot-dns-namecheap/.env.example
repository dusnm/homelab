# Copy to $DATA_ROOT/certbot-dns-namecheap/.env (chmod 600). Namecheap: Profile > Tools > API Access.
NAMECHEAP_API_USER=your-namecheap-user
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=203.0.113.10   # your public IP, whitelisted in Namecheap's API settings
CERTBOT_EMAIL=you@example.com      # Let's Encrypt expiry notices
CERTBOT_STAGING=true               # test against Let's Encrypt staging first, then set false

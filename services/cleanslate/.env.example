# Copy to $DATA_ROOT/cleanslate/.env (chmod 600).
CLEANSLATE_SRC=/srv/homelab/cleanslate   # git clone https://github.com/successible/cleanslate
# Host ports (127.0.0.1 only; nginx/sites/cleanslate.conf expects these)
AUTHENTICATION_SERVER_PORT=3010
CLIENT_PORT=3011
HASURA_PORT=3012
POSTGRES_PORT=3013
POSTGRES_PASSWORD=
HASURA_GRAPHQL_ADMIN_SECRET=
JWT_SIGNING_SECRET=
HASURA_GRAPHQL_JWT_SECRET='{"type":"HS256","key":"<the JWT_SIGNING_SECRET value>"}'

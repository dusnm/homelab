# Copy to $DATA_ROOT/borgmatic/config/config.yaml. borgmatic 2.x, borg 1.4, repokey-blake2.
# ${...} come from the container environment: compose.yml and $DATA_ROOT/borgmatic/.env.
# The source folders must also be mounted: see compose.override.yml.example.
#
# First run:  homelab compose borgmatic exec borgmatic borgmatic repo-create --encryption repokey-blake2
# Then export the key and keep it with the passphrase, outside this machine:
#             homelab compose borgmatic exec borgmatic borgmatic key export

repositories:
  - path: ${BORGBASE_REPO}
    label: borgbase

encryption_passphrase: ${BORG_PASSPHRASE}
ssh_command: ssh -i /root/.ssh/id_ed25519 -o UserKnownHostsFile=/root/.ssh/known_hosts -o ServerAliveInterval=60

source_directories:
  - ${DATA_ROOT}                         # every service's data, configs and secrets
  - ${MEDIA_ROOT}/music                  # music library
  - ${NEXTCLOUD_ROOT}                    # Nextcloud files
  - /var/lib/docker/volumes/paperless_data
  - /var/lib/docker/volumes/paperless_media   # Paperless documents
  - /host/etc                            # the host's /etc (nginx, fstab, ...)
one_file_system: true

exclude_patterns:
  - ${DATA_ROOT}/borgmatic/cache
  - ${DATA_ROOT}/borgmatic/state
  - ${DATA_ROOT}/immich/postgres         # dumped below instead
  - ${DATA_ROOT}/immich/library/thumbs   # regenerated by Immich
  - ${DATA_ROOT}/immich/library/encoded-video
  - ${DATA_ROOT}/slskd/data/downloads    # incomplete downloads
  - ${NEXTCLOUD_ROOT}/data/appdata_*/preview   # regenerated by Nextcloud
  - '*/node_modules'
exclude_caches: true

compression: auto,zstd,3
upload_rate_limit: 0                     # KiB/s; e.g. 200 on a slow uplink (0 = unlimited)
archive_name_format: '{hostname}-{now:%Y-%m-%dT%H:%M:%S}'   # hostname: BACKUP_HOSTNAME
retries: 3
retry_wait: 60

keep_daily: 7
keep_weekly: 4
keep_monthly: 12

checks:
  - name: repository
    frequency: 2 weeks
  - name: archives
    frequency: 2 weeks

# Consistent database dumps, streamed into each archive (the container joins these networks).
postgresql_databases:
  - name: all
    hostname: immich_postgres
    username: postgres
    password: ${IMMICH_DB_PASSWORD}
    format: custom
  - name: all
    hostname: paperless-db
    username: paperless
    password: ${PAPERLESS_DB_PASSWORD}
    format: custom
  - name: all
    hostname: database                   # CleanSlate
    username: postgres
    password: ${CLEANSLATE_DB_PASSWORD}
    format: custom

mariadb_databases:
  - name: all
    hostname: nextcloud-db
    username: root
    password: ${NEXTCLOUD_DB_ROOT_PASSWORD}

# Copy to $DATA_ROOT/borgmatic/.env (chmod 600).
BORG_PASSPHRASE=change-me                     # keep a copy outside this machine, with the exported repo key
BORGBASE_REPO=ssh://xxxxxxxx@xxxxxxxx.repo.borgbase.com/./repo
BACKUP_HOSTNAME=homelab
# Database passwords for the dumps (the same values as in those services' .env files)
IMMICH_DB_PASSWORD=
PAPERLESS_DB_PASSWORD=
CLEANSLATE_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=

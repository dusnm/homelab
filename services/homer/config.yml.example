# Copy to $DATA_ROOT/homer/data/config.yml and replace example.com with your host names.
# Icons referenced below go in $DATA_ROOT/homer/data/icons.
---
# Homepage configuration
# See https://fontawesome.com/v5/search for icons options

title: "My Home Lab"
subtitle: "Homer"
logo: "assets/icons/dark_circle.png"
#icon: "fas fa-skull-crossbones" # Optional icon

header: true
footer: false

# Optional theme customization
theme: neon
colors:
  light:
    highlight-primary: "#3367d6"
    highlight-secondary: "#4285f4"
    highlight-hover: "#5a95f5"
    background: "#f5f5f5"
    card-background: "#ffffff"
    text: "#363636"
    text-header: "#303030"
    text-title: "#303030"
    text-subtitle: "#424242"
    card-shadow: rgba(0, 0, 0, 0.1)
    link: "#3273dc"
    link-hover: "#363636"
  dark:
    highlight-primary: "#3367d6"
    highlight-secondary: "#4285f4"
    highlight-hover: "#5a95f5"
    background: "#131313"
    card-background: "#2b2b2b"
    text: "#eaeaea"
    text-header: "#ffffff"
    text-title: "#fafafa"
    text-subtitle: "#f5f5f5"
    card-shadow: rgba(0, 0, 0, 0.4)
    link: "#3273dc"
    link-hover: "#ffdd57"

# Optional navbar
# links: [] # Allows for navbar (dark mode, layout, and search) without any links
#links: []
        #- name: "Contribute"
        #icon: "fab fa-github"
        # url: "https://github.com/bastienwirtz/homer"
        # target: "_blank" # optional html a tag target attribute
        #- name: "Wiki"
        # icon: "fas fa-book"
        # url: "https://www.wikipedia.org/"
  # this will link to a second homer page that will load config from additional-page.yml and keep default config values as in config.yml file
  # see url field and assets/additional-page.yml.dist used in this example:
  #- name: "another page!"
  #  icon: "fas fa-file-alt"
  #  url: "#additional-page" 

# Services
# First level array represent a group.
# Leave only a "items" key if not using group (group name, icon & tagstyle are optional, section separation will not be displayed).
services:
  - name: "Services"
    icon: "fas fa-shapes"
    items:
      - name: "Nextcloud"
        logo: "assets/tools/nextcloud.png"
        subtitle: "Files, calendar and contacts in your own cloud"
        url: "https://cloud.example.com"
        target: "_blank"
      - name: "Deluge"
        logo: "assets/tools/deluge.png"
        subtitle: "A web-based torrent client"
        url: "https://deluge.example.com"
        target: "_blank"
      - name: "Prowlarr"
        logo: "assets/tools/prowlarr.png"
        subtitle: "A torrent tracker management tool"
        url: "https://prowlarr.example.com"
        target: "_blank"
      - name: "Beszel"
        icon: "fas fa-heartbeat"
        subtitle: "Server and container monitoring"
        url: "https://monitor.example.com"
        target: "_blank"
      - name: "SearxNG"
        logo: "assets/tools/searxng.png"
        subtitle: "A privacy respecting metasearch engine"
        url: "https://search.example.com"
        target: "_blank"
      - name: "Mealie"
        logo: "assets/tools/mealie.png"
        subtitle: "Recipe manager and meal planner"
        url: "https://recipes.example.com"
        target: "_blank"
      - name: "CleanSlate"
        logo: "assets/tools/cleanslate.png"
        subtitle: "Calorie and macro tracker"
        url: "https://macros.example.com"
        target: "_blank"
      - name: "Adguard"
        logo: "assets/tools/adguardhome.png"
        subtitle: "AdBlock & DNS Proxy"
        url: "https://dns.example.com"
        target: "_blank"
  - name: "Media"
    icon: "fas fa-film"
    items:
      - name: "Navidrome"
        logo: "assets/tools/navidrome.png"
        subtitle: "Music server (web player + Subsonic apps)"
        url: "https://music.example.com"
        target: "_blank"
      - name: "Immich"
        logo: "assets/tools/immich.png"
        subtitle: "Photo library with face recognition and smart search"
        url: "https://photos.example.com"
        target: "_blank"
      - name: "SLSKD"
        logo: "assets/tools/slskd.png"
        subtitle: "Soulseek client"
        url: "https://slskd.example.com"
        target: "_blank"
      - name: "MeTube"
        logo: "assets/tools/metube.png"
        subtitle: "Video and audio downloads from YouTube and other sites"
        url: "https://download.example.com"
        target: "_blank"
  - name: "Productivity"
    icon: "fas fa-pencil"
    items:
      - name: "Wastebin"
        logo: "assets/tools/wastebin.png"
        subtitle: "Pastebin-like public text storage"
        url: "https://paste.example.com"
        target: "_blank"
      - name: "Vikunja"
        logo: "assets/tools/vikunja.png"
        subtitle: "To-do lists and kanban boards"
        url: "https://tasks.example.com"
        target: "_blank"
      - name: "Paperless"
        logo: "assets/tools/paperless.png"
        subtitle: "Scanned documents with OCR and full-text search"
        url: "https://docs.example.com"
        target: "_blank"

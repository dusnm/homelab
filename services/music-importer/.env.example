# Copy to $DATA_ROOT/music-importer/.env (chmod 600).
MUSIC_IMPORTER_SRC=https://github.com/dusnm/music-importer.git   # or the path of a local checkout
MUSIC_IMPORTER_VERSION=local                 # image tag (music-importer:local); `mi status` shows the real version
FANARTTV_API_KEY=                            # optional: fanart.tv as a cover source
BANDCAMP_COOKIES=                            # optional: your bandcamp.com "identity" cookie (mi bandcamp)
SLSKD_URL=http://slskd:5030                  # optional: mi slskd (Soulseek search)
SLSKD_API_KEY=                               # the api_keys key from slskd.yml

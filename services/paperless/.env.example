# Copy to $DATA_ROOT/paperless/.env (chmod 600).
POSTGRES_PASSWORD=
PAPERLESS_SECRET_KEY=             # openssl rand -hex 32
PAPERLESS_ADMIN_USER=admin        # created on first start
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_OCR_LANGUAGES=          # extra Tesseract languages to install, e.g. "deu fra"
PAPERLESS_OCR_LANGUAGE=eng        # languages to OCR with, e.g. "eng+deu"

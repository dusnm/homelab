# Settings for this homelab. Copy to homelab.env (git-ignored) and adjust.
# Format: KEY=value, one per line; no shell expansion, quotes around a value are optional.
# Secrets do NOT go here: each service keeps its own .env in $DATA_ROOT/<service>/.env
# (see services/<service>/.env.example).

# Your domain. Every service gets a host name below it (see HOST_* further down).
DOMAIN=example.com

# Time zone (tz database name) and the user/group that owns the data.
TZ=Etc/UTC
PUID=1000
PGID=1000

# Where things live on this machine.
DATA_ROOT=/srv/homelab          # per-service state and secrets: $DATA_ROOT/<service>/...
MEDIA_ROOT=/srv/media           # music/, music-inbox/, music-replaced/, games/ ... (Deluge, Navidrome, ...)
NEXTCLOUD_ROOT=/srv/nextcloud   # Nextcloud's /var/www/html (its data/ folder holds the users' files)
LETSENCRYPT_DIR=/etc/letsencrypt

# Your LAN, for services that trust a reverse proxy or LAN clients.
LAN_SUBNET=192.168.1.0/24

# Which services `homelab up` (without names) starts. Empty = every folder under services/.
SERVICES=

# Host names. Leave a line commented out to use the default shown. The wildcard certificate
# covers the bare domain and one level of subdomains.
#HOST_AUTH=auth.example.com          # Authelia login portal
#HOST_HOME=example.com               # Homer dashboard (Authelia), on the bare domain
#HOST_MUSIC=music.example.com        # Navidrome
#HOST_PHOTOS=photos.example.com      # Immich
#HOST_CLOUD=cloud.example.com        # Nextcloud
#HOST_DOCS=docs.example.com          # Paperless-ngx
#HOST_RECIPES=recipes.example.com    # Mealie
#HOST_TASKS=tasks.example.com        # Vikunja
#HOST_SEARCH=search.example.com      # SearXNG
#HOST_PASTE=paste.example.com        # Wastebin
#HOST_OFFICE=office.example.com      # Euro-Office document server
#HOST_MACROS=macros.example.com      # CleanSlate
#HOST_DNS=dns.example.com            # AdGuard Home admin (Authelia)
#HOST_MONITOR=monitor.example.com    # Beszel (Authelia)
#HOST_DOWNLOAD=download.example.com  # MeTube (Authelia)
#HOST_SLSKD=slskd.example.com        # slskd (Authelia)
#HOST_DELUGE=deluge.example.com      # Deluge (Authelia)
#HOST_PROWLARR=prowlarr.example.com  # Prowlarr (Authelia)
